{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Permissions the main window needs: picking folders and files, opening the finished SD card, and opening the author's site in the browser.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"dialog:allow-open",
		"dialog:allow-save",
		"dialog:allow-message",
		"opener:allow-open-path",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{
					"url": "https://u11g.com"
				},
				{
					"url": "https://u11g.com/*"
				}
			]
		}
	]
}
