{
	"name": "@epaper-studio/studio",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Desktop app that turns birthdays, holidays and photos into pictures for a Waveshare PhotoPainter e-paper display",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"check-types": "tsc --noEmit",
		"preview": "vite preview",
		"tauri": "tauri",
		"app:dev": "tauri dev",
		"app:build": "tauri build",
		"icons": "node scripts/generate-icons.mjs",
		"test": "cargo test --manifest-path src-tauri/crates/epaper-core/Cargo.toml"
	},
	"dependencies": {
		"@cascivo/icons": "^1.1.0",
		"@cascivo/react": "^1.3.1",
		"@cascivo/themes": "^1.0.0",
		"@fontsource/inter": "^5.2.5",
		"@preact/signals-react": "^3.12.0",
		"@tauri-apps/api": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.2.1",
		"@tauri-apps/plugin-opener": "^2.2.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"zustand": "^5.0.4"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.5.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0"
	}
}
